# LinguaFlix — Extension build-time environment variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
# See README.md for setup instructions for each service.

# ── Supabase ──────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google OAuth ──────────────────────────────────────────
# The OAuth 2.0 Client ID for the extension.
# Also paste this into manifest.json → oauth2.client_id.
# See README.md → "Google OAuth Setup" for step-by-step instructions.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── PostHog Analytics ─────────────────────────────────────
# Found in: PostHog → Project Settings → Project API key
VITE_POSTHOG_KEY=phc_your-posthog-project-key
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Sentry Error Monitoring ───────────────────────────────
# Found in: Sentry → Settings → Projects → <project> → Client Keys
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ═══════════════════════════════════════════════════════════
# Supabase Edge Function secrets — NOT used by the extension
# Set these with: supabase secrets set KEY=value
# ═══════════════════════════════════════════════════════════
# GOOGLE_TRANSLATE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
